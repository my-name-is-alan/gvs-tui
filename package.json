{
  "name": "gvs-tui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=26.3.0"
  },
  "scripts": {
    "dev": "bun run build:bridge && bun --bun vite",
    "build": "bun run build:bridge && tsc --noEmit && vite build",
    "build:bridge": "bun scripts/build-bridge.ts",
    "start": "bun --bun dist/main.js"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "vue": "^3.5.40",
    "vue-termui": "^0.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@types/bun": "^1.3.5",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
