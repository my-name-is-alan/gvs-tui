{
  "name": "gvs-tui",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=26.3.0"
  },
  "scripts": {
    "dev": "bun --bun vite --force",
    "dev:clean": "bun run scripts/dev-clean.ts && bun --bun vite --force",
    "build": "tsc --noEmit && vite build && bun run scripts/bundle-tools.ts && bun run scripts/bundle-runtime.ts",
    "setup": "bun run tools:prepare",
    "package:windows": "bun run build && bun run scripts/package-windows.ts",
    "check:portable": "bun run scripts/check-portable.ts",
    "tools:prepare": "bun run scripts/bundle-tools.ts --prepare",
    "start": "bun --bun dist/main.js",
    "preview": "bun run scripts/preview.ts"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-termui": "^0.3.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@types/bun": "^1.3.5",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
